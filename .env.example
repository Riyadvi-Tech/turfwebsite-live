# Server-only variables (used by the Vercel serverless functions in /api).
# NEVER expose these through any VITE_* variable or commit them to the repo.

# MongoDB Atlas connection string for the production database.
MONGODB_URI=
MONGODB_DB=turfon24

# All of the following are REQUIRED for the admin login + password-reset flow:
# - APP_URL: the deployed HTTPS origin of the website, WITHOUT a trailing
#   slash. Used to build the password reset link in the email.
#   Example: https://turfon24.vercel.app
APP_URL=

# Email sender address (must be allowed by your SMTP provider).
MAIL_FROM=

# Destination address that receives the password-reset email.
# If left blank, the admin's own registered email is used instead.
RESET_DEST_EMAIL=

# SMTP provider connection details.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Set to "true" for a secure (TLS) SMTP port (e.g. 465).
SMTP_SECURE=false

# Payment configuration (used by /api/payment/create).
HOURLY_RATE=800
PAYMENT_UPI_ID=turfon24@okaxis
PAYMENT_UPI_NAME=Turfon24

# Server-only MSG91 account key used to verify the existing OTP widget access token.
MSG91_AUTH_KEY=